{
  "AWS": {
    "S3Region": "us-east-1",
    "S3Bucket": "your-backup-bucket",
    "BackupDirectories": ["/home/user/Documents", "/home/user/Pictures"],
    "ContentDisposition": "attachment",
    "ServerSideEncryption": "AES256",
    "StorageClass": "STANDARD"
  },
  "Logging": {
    "logfile_location": "/var/log/s3backup",
    "max_backups": 4,
    "max_size": 10,
    "max_age": 30,
    "console": false
  }
}
